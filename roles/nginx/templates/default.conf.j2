# {{ ansible_managed }}
server {
    listen       {{ nginx_host_port }};
    server_name  _;
    server_tokens off;

    root   /usr/share/nginx/html;
    index  index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }
}
